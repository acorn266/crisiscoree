# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored — never commit real keys.

# --- Required for live weather / heatwave / drought / cyclone layers (free tier) ---
# Get a free key at https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# --- Optional: AI chatbot (Google Gemini free tier, no credit card) ---
# Get a free key at https://aistudio.google.com/apikey
# Without a key the chatbot still works using built-in safety answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15
CHAT_RATE_LIMIT_PER_MINUTE=10

# --- Caching (seconds) ---
WEATHER_CACHE_TTL=600
WEATHER_MAX_WORKERS=8
DISASTER_CACHE_TTL=3600

# --- Optional: satellite flood detection via Google Earth Engine ---
# Off by default. Needs `pip install -r requirements-flood.txt` and `earthengine authenticate`.
FLOOD_DETECTION_ENABLED=false
